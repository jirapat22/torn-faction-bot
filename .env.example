# Torn Faction Discord Bot - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub - only commit .env.example

# ===== DISCORD BOT TOKEN =====
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ===== DISCORD SERVER & CHANNEL IDS =====
# Enable Developer Mode: Discord Settings → Advanced → Developer Mode
# Right-click server/channel → Copy ID

GUILD_ID=your_server_id_here
INACTIVITY_ALERTS_CHANNEL_ID=your_channel_id_here
ANNOUNCEMENTS_CHANNEL_ID=your_channel_id_here
WAR_CHANNEL_ID=your_channel_id_here
WAR_MANAGEMENT_CHANNEL_ID=your_channel_id_here
CHAINING_CHANNEL_ID=your_channel_id_here
HAPPY_JUMP_CHANNEL_ID=0

# ===== TORN API SETTINGS =====
# Get API key from: https://www.torn.com/preferences.php#tab=api
TORN_API_KEY=your_torn_api_key_here
TORN_FACTION_ID=your_faction_id_here

# ===== MANAGEMENT ROLE IDS =====
# Comma-separated list of Discord role IDs that can use management commands
# Example: 1234567890,9876543210,1111111111
MANAGEMENT_ROLE_IDS=your_role_id_1,your_role_id_2,your_role_id_3

# ===== BOT SETTINGS (Optional) =====
COMMAND_PREFIX=!
INACTIVITY_WARNING_DAYS=3
INACTIVITY_CRITICAL_DAYS=5
TORN_API_CACHE_SECONDS=30
TORN_API_MAX_REQUESTS_PER_MINUTE=60
